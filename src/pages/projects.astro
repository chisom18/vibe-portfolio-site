---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const projects = [
  { title: 'Project One', category: 'Brand Identity', description: '[Add project description]', image: '/images/project-one.svg', href: '#' },
  { title: 'Project Two', category: 'Packaging', description: '[Add project description]', image: '/images/project-two.svg', href: '#' },
  { title: 'Project Three', category: 'Campaign', description: '[Add project description]', image: '/images/project-three.svg', href: '#' },
  { title: 'Project Four', category: 'Editorial', description: '[Add project description]', image: '/images/project-four.svg', href: '#' },
  { title: 'Project Five', category: 'Strategy', description: '[Add project description]', image: '/images/project-five.svg', href: '#' },
  { title: 'Project Six', category: 'Identity', description: '[Add project description]', image: '/images/project-six.svg', href: '#' },
];
---

<BaseLayout
  pageTitle="Projects | Elikwu Chisom"
  description="Selected project work by Elikwu Chisom — portfolio placeholder gallery."
>
  <Navigation />

  <main>
    <section class="page-hero section-shell">
      <p class="eyebrow accent">Selected work</p>
      <h1>SELECTED WORK.</h1>
      <p class="lead">A small collection of brand design explorations, identities, and visual thinking.</p>
    </section>

    <section class="gallery section-shell" aria-label="Project gallery">
      <div class="gallery-grid">
        {projects.map((project, index) => (
          <article class={`project-tile project-tile--${index % 2 === 0 ? 'wide' : 'tall'}`}>
            <div class="project-tile__media">
              <img src={project.image} alt={project.title} />
            </div>
            <div class="project-tile__content">
              <p class="project-kicker">{project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a href={project.href} class="text-link">View project</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="newsletter section-shell">
      <div class="newsletter__inner">
        <p class="eyebrow accent">NEWSLETTER</p>
        <h2>Interested in what I’m making and learning? Join the list.</h2>
        <NewsletterForm />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
